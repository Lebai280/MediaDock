<?xml version="1.0" encoding="utf-8"?>
<!--
  用户可能填 http 的 WebDAV 地址（局域网 NAS），所以放行明文。
  公网地址走 HTTPS，不受影响。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
